<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStatRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/cardFrameColor"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewConnectionAccent"
            android:layout_width="8dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:animateLayoutChanges="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewConnectionAccent"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtPrimaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:text="@string/student_name"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/layoutEndContainer" />

                <TextView
                    android:id="@+id/txtSecondaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txtPrimaryLabel"
                    android:textSize="12sp"
                    android:textColor="?attr/descriptiveTextColor"
                    android:text="@string/student_email"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/layoutEndContainer" />

                <LinearLayout
                    android:id="@+id/layoutEndContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <!-- Stack 1: Signal -->
                    <LinearLayout
                        android:id="@+id/layoutSignalStack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgSignalIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/txtStatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/descriptiveTextColor" />
                    </LinearLayout>

                    <!-- Stack 2: Battery -->
                    <LinearLayout
                        android:id="@+id/layoutBatteryStack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgBatteryIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_battery_full"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/txtStatValueSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/descriptiveTextColor" />
                    </LinearLayout>

                    <!-- Legacy vertical stack for non-device cards -->
                    <LinearLayout
                        android:id="@+id/layoutLegacyValueStack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/txtLegacyStatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/txtLegacyStatValueSecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="?attr/descriptiveTextColor"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/layoutExpandedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="16dp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
