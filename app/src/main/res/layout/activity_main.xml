<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/layoutUniversalContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/layoutDashboardView"
            layout="@layout/layout_dashboard" />

        <include
            android:id="@+id/layoutCourseView"
            layout="@layout/layout_course"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutSessionView"
            layout="@layout/layout_session_detail"
            android:visibility="gone" />

        <include
            android:id="@+id/layoutCourseStatisticsView"
            layout="@layout/layout_course_statistics"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="10dp"
        android:background="?android:attr/statusBarColor" />

    <RelativeLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@android:color/white" />
    </RelativeLayout>

</FrameLayout>