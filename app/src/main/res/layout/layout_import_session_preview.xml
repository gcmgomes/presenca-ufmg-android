<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_import_sessions"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/txtImportCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_import_sessions_hint"
        android:textColor="?attr/descriptiveTextColor"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvImportPreview"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#08000000" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/dialog_import_sessions_button_text"
        app:cornerRadius="8dp"
        android:padding="12dp" />
</LinearLayout>
