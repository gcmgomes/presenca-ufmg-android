<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/cardBackgroundColor"
    app:cardElevation="0dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="?attr/cardFrameColor">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/viewCourseAccent"
            android:layout_width="12dp"
            android:layout_height="0dp"
            android:background="@color/chalk_yellow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCourseName"
            android:text="@string/hint_course_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="200sp"
            android:textColor="?attr/colorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/imgEditCourseDashboard"
            app:layout_constraintStart_toEndOf="@id/viewCourseAccent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCourseDetails"
            android:text="@string/hint_course_semester"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:textColor="?attr/descriptiveTextColor"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/viewCourseAccent"
            app:layout_constraintTop_toBottomOf="@id/txtCourseName" />

        <ImageView
            android:id="@+id/imgEditCourseDashboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_edit_course"
            android:padding="12dp"
            android:src="@drawable/ic_edit"
            app:tint="?attr/actionItemColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>