<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtImportStudentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_import_students"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtImportStudentCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/dialog_import_students_hint"
        android:textColor="?attr/descriptiveTextColor" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvImportStudentPreview"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmStudentImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dialog_import_students_button_text"
        app:cornerRadius="8dp" />
</LinearLayout>