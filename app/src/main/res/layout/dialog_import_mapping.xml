<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtMappingSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/dialog_mapping_subtitle"
        android:textSize="14sp"
        android:textColor="?attr/descriptiveTextColor" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_mapping_preview_header"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        android:textColor="?attr/descriptiveTextColor" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#08000000"
        android:padding="12dp">
        <LinearLayout
            android:id="@+id/layoutPreviewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Preview items will be added here -->
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/mappingFieldsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Mapping rows will be added here dynamically -->
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmMapping"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_mapping_button_continue" />

</LinearLayout>
